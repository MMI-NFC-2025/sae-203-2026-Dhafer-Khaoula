---
import { Image } from "astro:assets";
import LogoSmall from "../assets/icons/logo_small_img.svg";
import IconMenu from "../assets/icons/menu_icon.svg";
import IconClose from "../assets/icons/cross_icon.svg";
---

<header class="flex items-center justify-between px-6 py-4 bg-[var(--color-blue-4)]">
  <a href="/">
    <Image src={LogoSmall} alt="Logo les rives du territoire" class="w-16" />
  </a>
  <div class="flex items-center gap-4">
    <a href="/login" class="bg-white text-[var(--color-blue-4)] font-bold px-4 py-2 rounded hover:bg-[var(--color-blue-1)] hover:text-white transition">Login</a>
    <button id="menuBtn" aria-label="Ouvrir le menu">
      <Image src={IconMenu} alt="Menu" class="w-8" />
    </button>
  </div>
</header>

<nav id="menu" class="fixed inset-0 bg-[var(--color-blue-1)] z-50 flex flex-col pointer-events-none opacity-0 translate-x-full transition-all duration-300">
  <div class="flex justify-between items-center px-8 pt-8 pb-12">
    <Image src={LogoSmall} alt="Logo les rives du territoire" class="w-40" />
    <button id="closeMenu" aria-label="Fermer le menu">
      <Image src={IconClose} alt="Fermer" class="w-8" />
    </button>
  </div>
  <ul class="menu__content-list pl-8">
    <li class="menu__content-item pb-12 text-[var(--color-light-gray-1)] font-inder text-[2.125rem]">
      <a href="/about" class="menu__content-link">À propos</a>
    </li>
    <li class="menu__content-item pb-12 text-[var(--color-light-gray-1)] font-inder text-[2.125rem]">
      <a href="/programme" class="menu__content-link">Programme</a>
    </li>
    <li class="menu__content-item pb-12 text-[var(--color-light-gray-1)] font-inder text-[2.125rem]">
      <a href="/artistes" class="menu__content-link">Artistes</a>
    </li>
    <li class="menu__content-item pb-12 text-[var(--color-light-gray-1)] font-inder text-[2.125rem]">
      <a href="/scenes" class="menu__content-link">Scènes</a>
    </li>
    <li class="menu__content-item pb-12 text-[var(--color-light-gray-1)] font-inder text-[2.125rem]">
      <a href="/infos" class="menu__content-link">Informations</a>
    </li>
    <li class="menu__content-item pb-12 text-[var(--color-light-gray-1)] font-inder text-[2.125rem]">
      <a href="/contact" class="menu__content-link">Contact</a>
    </li>
  </ul>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const menu = document.getElementById('menu');
    const menuBtn = document.getElementById('menuBtn');
    const closeMenu = document.getElementById('closeMenu');
    const body = document.body;
    menuBtn.addEventListener('click', () => {
      menu.classList.remove('pointer-events-none', 'opacity-0', 'translate-x-full');
      menu.classList.add('pointer-events-auto', 'opacity-100', 'translate-x-0');
      body.classList.add('overflow-hidden');
    });
    closeMenu.addEventListener('click', () => {
      menu.classList.add('pointer-events-none', 'opacity-0', 'translate-x-full');
      menu.classList.remove('pointer-events-auto', 'opacity-100', 'translate-x-0');
      body.classList.remove('overflow-hidden');
    });
  });
</script> 