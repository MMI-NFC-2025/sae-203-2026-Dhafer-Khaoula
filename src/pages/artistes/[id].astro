---
import Layout from "../../layouts/Layout.astro";
import Pbimage from "../../components/Pbimage.astro";

import {
  pb,
  getArtistById,
  saveRecord,
  deleteArtistById,
} from "../../../backend/backend.mjs";

const { id } = Astro.params;
let artiste = await getArtistById(id);
let message = "";

const isAdmin = pb.authStore.isAdmin;

// Gestion admin
if (Astro.request.method === "POST" && isAdmin) {
  const formData = await Astro.request.formData();

  if (formData.get("delete")) {
    await deleteArtistById(id);
    return Astro.redirect("/artistes");
  }

  await saveRecord("Artistes", formData, id);
  message = "Modifications enregistrées !";
  artiste = await getArtistById(id);
}
---

<Layout title={artiste.nom_artistes}>

  <!-- SECTION PRINCIPALE -->
  <section class="max-w-4xl mx-auto px-4 mt-10 mb-20">
    <Pbimage
      record={artiste}
      filename={artiste.photo__artiste}
      alt={artiste.nom_artistes}
      classImg="w-full max-h-[420px] object-cover rounded-4xl shadow mb-8"
    />
    <h2 class="text-4xl md:text-5xl font-bold mb-4">{artiste.nom_artistes}</h2>
    <p class="text-lg text-gray-700 mb-4"><strong>Genre :</strong> {artiste.genre}</p>
    <p class="text-gray-700 text-lg mb-10">{artiste.description_artiste}</p>
    <h2 class="text-2xl font-bold mb-4">Horaires</h2>
    <div class="space-y-1 text-gray-700 mb-10">
      <p><strong>Jour :</strong> {artiste.date_representation?.slice(0, 10) || "Non renseigné"}</p>
      <p><strong>Heure :</strong> {artiste.date_representation?.slice(11, 16) || "Non renseignée"}</p>
      <p><strong>Scène :</strong> {artiste.expand?.scene?.nom_scene || "Non renseignée"}</p>
    </div>
    {artiste.galerie?.length > 0 && (
      <>
        <h2 class="text-2xl font-bold mb-4">Galerie</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-12">
          {artiste.galerie.map((img) => (
            <Pbimage
              record={artiste}
              filename={img}
              alt={artiste.nom_artistes}
              classImg="w-full h-48 object-cover rounded-4xl shadow"
            />
          ))}
        </div>
      </>
    )}
    {message && <p class="text-green-600 font-medium mb-6">{message}</p>}
    {isAdmin && (
      <section class="bg-white border border-gray-300 rounded-4xl shadow p-6 mb-10">
        <h2 class="text-2xl font-bold mb-4">Modifier cet artiste</h2>
        <form method="POST" enctype="multipart/form-data" class="flex flex-col gap-4">
          <input type="text" name="nom_artistes" value={artiste.nom_artistes} class="border p-2 rounded" />
          <input type="text" name="genre" value={artiste.genre} class="border p-2 rounded" />
          <textarea name="description_artiste" class="border p-2 rounded">{artiste.description_artiste}</textarea>
          <label class="font-medium">Ajouter des images à la galerie :</label>
          <input type="file" name="galerie" multiple class="border p-2 rounded" />
          <button class="bg-cyan-600 text-white px-4 py-2 rounded shadow hover:bg-cyan-700 transition">Enregistrer</button>
        </form>
        <form method="POST" class="mt-4">
          <button name="delete" value="1" class="bg-red-600 text-white px-4 py-2 rounded shadow hover:bg-red-700 transition">Supprimer l'artiste</button>
        </form>
      </section>
    )}
  </section>

</Layout>