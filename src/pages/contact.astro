---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
---

<Layout title="Contact">

  <!-- HERO -->
  <Hero brand="Les rives du territoire" title="Contact" />

  <!-- CONTENT -->
  <section class="max-w-3xl mx-auto px-4">

    <!-- FORMULAIRE -->
    <h2 class="text-2xl font-bold-700 mb-6">Formulaire de contact</h2>

    <form class="space-y-6" action="#" method="post">

      <!-- NOM + PRÉNOM -->
      <div>
        <label for="firstname" class="block font-semibold text-cyan-700 mb-1">
          Nom <span class="text-red-500">*</span>
        </label>

        <div class="flex gap-4">
          <div class="flex-1">
            <input
              id="firstname"
              name="firstname"
              type="text"
              required
              class="w-full border rounded-md px-3 py-2"
            />
            <span class="text-sm text-gray-500">Prénom</span>
          </div>

          <div class="flex-1">
            <input
              id="lastname"
              name="lastname"
              type="text"
              required
              class="w-full border rounded-md px-3 py-2"
            />
            <span class="text-sm text-gray-500">Nom</span>
          </div>
        </div>
      </div>

      <!-- EMAIL -->
      <div>
        <label for="email" class="block font-semibold text-cyan-700 mb-1">
          E-mail <span class="text-red-500">*</span>
        </label>
        <input
          id="email"
          name="email"
          type="email"
          required
          class="w-full border rounded-md px-3 py-2"
        />
      </div>

      <!-- SUJET -->
      <div>
        <label for="subject" class="block font-semibold text-cyan-700 mb-1">
          Sujet <span class="text-red-500">*</span>
        </label>
        <input
          id="subject"
          name="subject"
          type="text"
          required
          class="w-full border rounded-md px-3 py-2"
        />
      </div>

      <!-- MESSAGE -->
      <div>
        <label for="message" class="block font-semibold text-cyan-700 mb-1">
          Message <span class="text-red-500">*</span>
        </label>
        <textarea
          id="message"
          name="message"
          rows="6"
          required
          class="w-full border rounded-md px-3 py-2"
        ></textarea>
      </div>

    </form>

    <!-- BOUTON -->
    <div class="flex justify-center mt-6 mb-12">
      <button
        class="bg-cyan-600 text-white px-6 py-2 rounded shadow hover:bg-cyan-700 transition"
        aria-label="Bouton pour envoyer le formulaire"
      >
        Envoyer le formulaire
      </button>
    </div>

    <!-- COORDONNÉES -->
    <h2 class="text-2xl font-bold-700 mb-4">Coordonnées</h2>

    <p class="text-gray-700 mb-2">
      Numéro de téléphone : +33 X XX XX XX XX
    </p>

    <p class="text-gray-700 mb-8">
      Adresse mail : nathan.batista_balanche@edu.univ-fcomte.fr
    </p>

  </section>

</Layout>