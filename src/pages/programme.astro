---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import EventCard from "../components/EventCard.astro";

import { pb, getScenesByName } from "../../backend/backend.mjs";

let filter = null;

// Récupération artistes
const artistes = await pb.collection("Artistes").getFullList({
  sort: "nom_artistes",
  expand: "scene",
});

// Récupération scènes
const scenes = await getScenesByName();

// Dates uniques
function formatDateFr(dateStr) {
  const d = new Date(dateStr);
  return d.toLocaleDateString("fr-FR", { day: "numeric", month: "long" });
}

let dates = [...new Set(artistes.map((a) => a.date_representation.slice(0, 10)))];
dates = dates.sort((a, b) => new Date(a) - new Date(b));

// Genres uniques
const genres = [...new Set(artistes.map((a) => a.genre))];

// Lecture du filtre
if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  filter = formData.get("filter");
}
---

<Layout title="Programme">

  <!-- HERO -->
  <Hero brand="Les rives du territoire" title="Programme" />

  <!-- INTRO -->
  <section class="max-w-3xl mx-auto px-4 mt-10 mb-12">
    <p class="text-gray-700 leading-relaxed text-lg">
      Découvrez la programmation complète du festival : hip-hop, électro, indie, pop,
      répartis sur plusieurs scènes et sur plusieurs jours. Utilisez les filtres pour
      explorer les artistes selon leur genre, leur scène ou leur date de passage.
    </p>
  </section>

  <!-- FILTRES -->
  <form method="POST" class="flex flex-wrap gap-4 max-w-3xl mx-auto px-4 mb-12">
    <input type="hidden" name="filter" id="filterInput" />

    <button
      type="submit"
      onclick="document.getElementById('filterInput').value='genre'"
      class="px-4 py-2 bg-cyan-600 text-white rounded shadow hover:bg-cyan-700 transition"
    >
      Genre
    </button>

    <button
      type="submit"
      onclick="document.getElementById('filterInput').value='scene'"
      class="px-4 py-2 bg-cyan-600 text-white rounded shadow hover:bg-cyan-700 transition"
    >
      Scène
    </button>

    <button
      type="submit"
      onclick="document.getElementById('filterInput').value='date'"
      class="px-4 py-2 bg-cyan-600 text-white rounded shadow hover:bg-cyan-700 transition"
    >
      Date
    </button>
  </form>

  <!-- AFFICHAGE PAR DÉFAUT : TOUS LES ARTISTES -->
  {!filter && (
    <section class="max-w-5xl mx-auto px-4 mb-16">
      <h2 class="text-3xl font-bold text-cyan-700 mb-6">Tous les artistes</h2>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {artistes.map((a) => (
          <EventCard event={a} />
        ))}
      </div>
    </section>
  )}

  <!-- FILTRE GENRE -->
  {filter === "genre" && (
    <>
      {genres.map((g) => (
        <section class="max-w-5xl mx-auto px-4 mb-16">
          <h2 class="text-3xl font-bold text-cyan-700 mb-6">{g}</h2>

          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {artistes
              .filter((a) => a.genre === g)
              .map((a) => (
                <EventCard event={a} />
              ))}
          </div>
        </section>
      ))}
    </>
  )}

  <!-- FILTRE SCÈNE -->
  {filter === "scene" && (
    <>
      {scenes.map((s) => (
        <section class="max-w-5xl mx-auto px-4 mb-16">
          <h2 class="text-3xl font-bold text-cyan-700 mb-6">{s.nom_scene}</h2>

          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {artistes
              .filter((a) => a.scene === s.id)
              .map((a) => (
                <EventCard event={a} />
              ))}
          </div>
        </section>
      ))}
    </>
  )}

  <!-- FILTRE DATE -->
  {filter === "date" && (
    <>
      {dates.map((d) => (
        <section class="max-w-5xl mx-auto px-4 mb-16">
          <h2 class="text-3xl font-bold text-cyan-700 mb-6">{formatDateFr(d)}</h2>

          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {artistes
              .filter((a) => a.date_representation.startsWith(d))
              .map((a) => (
                <EventCard event={a} />
              ))}
          </div>
        </section>
      ))}
    </>
  )}

</Layout>