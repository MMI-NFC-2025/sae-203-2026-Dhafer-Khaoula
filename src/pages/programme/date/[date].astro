---
import Layout from "../../../layouts/Layout.astro";
import { getArtistsByDateFilter, formatDate } from "../../../../backend/backend.mjs";
import ArtisteCard from "../../../components/ArtisteCard.astro";

const { date } = Astro.params;

const artistes = await getArtistsByDateFilter(date);

const dateLisible = date;
---

<Layout title={`Date : ${dateLisible}`}>
    <h1 class="text-4xl text-cyan-700 mb-6">Artistes du {dateLisible}</h1>

    {artistes.length === 0 && <p>Aucun artiste trouvé.</p>}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {artistes.map((a) => <ArtisteCard artiste={a} />)}
    </div>
</Layout>
