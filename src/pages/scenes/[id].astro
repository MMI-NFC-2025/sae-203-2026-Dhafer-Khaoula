---
import Layout from "../../layouts/Layout.astro";
import ImagePB from "../../components/Pbimage.astro";
import {
  pb,
  getSceneById,
  getArtistsBySceneId,
  saveRecord,
  deleteSceneById,
} from "../../../backend/backend.mjs";

let pbMessage = "";

const { id } = Astro.params;

// GET : scène + artistes associés
const scene = await getSceneById(id);
let artistes = await getArtistsBySceneId(id);

if (!scene) return Astro.redirect("/scenes");

// POST : modification ou suppression
if (Astro.request.method === "POST" && pb.authStore.isAdmin) {
  const formData = await Astro.request.formData();

  if (formData.get("delete")) {
    await deleteSceneById(id);
    return Astro.redirect("/scenes");
  }

  await saveRecord("scenes", formData, id);
  pbMessage = "Modifications enregistrées !";

  artistes = await getArtistsBySceneId(id);
}
---

<Layout title={scene.nom_scene}>
  <section class="max-w-4xl mx-auto px-4 mt-10 mb-20">
    {scene.photo_scene && (
      <ImagePB
        record={scene}
        filename={scene.photo_scene}
        alt={scene.nom_scene}
        classImg="w-full max-h-[420px] object-cover rounded-4xl shadow mb-8"
      />
    )}
    <h2 class="text-4xl md:text-5xl font-bold mb-4">{scene.nom_scene}</h2>
    <p class="text-lg text-gray-700 mb-4"><strong>Localisation :</strong> {scene.localisation}</p>
    <p class="text-gray-700 text-lg mb-10">{scene.description_scene}</p>
    {pbMessage && <p class="text-green-600 font-medium mb-6">{pbMessage}</p>}
    <h2 class="text-2xl font-bold mb-4">Artistes programmés</h2>
    {artistes.length === 0 ? (
      <p>Aucun artiste programmé.</p>
    ) : (
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 mb-12">
        {artistes.map((artiste) => (
          <div class="rounded-4xl border bg-white p-4 shadow">
            <a href={`/artistes/${artiste.id}`} class="block">
              <ImagePB
                record={artiste}
                filename={artiste.photo__artiste}
                alt={artiste.nom_artistes}
                classImg="rounded-4xl shadow mb-2 w-full h-48 object-cover"
              />
              <h3 class="mt-2 mb-1 text-xl text-cyan-700">
                {artiste.nom_artistes}
              </h3>
            </a>
            <div class="mb-2 text-sm text-gray-600">
              <span class="font-semibold">Genre :</span> {artiste.genre}
              <br />
              <span class="font-semibold">Date :</span> {artiste.date_representation?.slice(0, 10)}
              <br />
              <span class="font-semibold">Heure :</span> {artiste.date_representation?.slice(11, 16)}
            </div>
          </div>
        ))}
      </div>
    )}
    {pb.authStore.isAdmin && (
      <section class="bg-white border border-gray-300 rounded-4xl shadow p-6 mb-10">
        <h2 class="text-2xl font-bold mb-4">Modifier la scène</h2>
        <form method="POST" enctype="multipart/form-data" class="flex flex-col gap-4">
          <input type="text" name="nom_scene" value={scene.nom_scene} class="border p-2 rounded" />
          <input type="text" name="localisation" value={scene.localisation} class="border p-2 rounded" />
          <textarea name="description_scene" class="border p-2 rounded">{scene.description_scene}</textarea>
          <label class="font-medium">Changer la photo :</label>
          <input type="file" name="photo_scene" class="border p-2 rounded" />
          <button class="bg-cyan-600 text-white px-4 py-2 rounded shadow hover:bg-cyan-700 transition">Enregistrer</button>
        </form>
        <form method="POST" class="mt-4">
          <button name="delete" value="1" class="bg-red-600 text-white px-4 py-2 rounded shadow hover:bg-red-700 transition">Supprimer la scène</button>
        </form>
      </section>
    )}
  </section>
</Layout>
