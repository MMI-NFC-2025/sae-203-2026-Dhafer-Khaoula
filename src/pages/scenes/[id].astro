---
import Layout from "../../layouts/Layout.astro";
import ImagePB from "../../components/Pbimage.astro";
import {
  pb,
  getSceneById,
  getArtistsBySceneId,
  saveRecord,
  deleteSceneById,
} from "../../../backend/backend.mjs";

let pbMessage = "";

const { id } = Astro.params;

// GET : scène + artistes associés
const scene = await getSceneById(id);
let artistes = await getArtistsBySceneId(id);

if (!scene) return Astro.redirect("/scenes");

// POST : modification ou suppression
if (Astro.request.method === "POST" && pb.authStore.isAdmin) {
  const formData = await Astro.request.formData();

  if (formData.get("delete")) {
    await deleteSceneById(id);
    return Astro.redirect("/scenes");
  }

  await saveRecord("scenes", formData, id);
  pbMessage = "Modifications enregistrées !";

  artistes = await getArtistsBySceneId(id);
}
---

<Layout title={scene.nom}>
  <h1 class="mb-4 text-5xl text-cyan-700">{scene.nom_scene}</h1>
  {
    scene.photo_scene && (
      <ImagePB
        record={scene}
        filename={scene.photo_scene}
        alt={scene.nom}
        classImg="w-full max-h-80 object-cover rounded mb-6 shadow"
      />
    )
  }
  <p class="mt-2 mb-4">{scene.description_scene}</p>
  <p class="mb-4"><strong>Adresse :</strong> {scene.localisation}</p>

  {pbMessage && <p class="mt-4 text-green-500">{pbMessage}</p>}

  <!-- ARTISTES PROGRAMMÉS -->
  <h2 class="mt-10 mb-4 text-3xl text-cyan-600">Artistes programmés</h2>

  {
    artistes.length === 0 ? (
      <p>Aucun artiste programmé.</p>
    ) : (
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {artistes.map((artiste) => (
          <div class="rounded-md border bg-white p-4 shadow">
            <a href={`/artistes/${artiste.id}`} class="block">
              <ImagePB
                record={artiste}
                filename={artiste.photo__artiste}
                alt={artiste.nom_artistes}
                classImg="rounded shadow mb-2 w-full h-48 object-cover"
              />
              <h3 class="mt-2 mb-1 text-xl text-cyan-700">
                {artiste.nom_artistes}
              </h3>
            </a>
            <div class="mb-2 text-sm text-gray-600">
              <span class="font-semibold">Genre :</span> {artiste.genre}
              <br />
              <span class="font-semibold">Date :</span>{" "}
              {artiste.date_representation?.slice(0, 10)}
              <br />
              <span class="font-semibold">Heure :</span>{" "}
              {artiste.date_representation?.slice(11, 16)}
              <br />
              <span class="font-semibold">Scène :</span> {scene.nom_scene}
            </div>
          </div>
        ))}
      </div>
    )
  }

  <!-- FORMULAIRE SUPERUSER -->
  {
    pb.authStore.isAdmin && (
      <>
        <form
          method="POST"
          enctype="multipart/form-data"
          class="mt-10 flex flex-col rounded border p-4"
        >
          <h2 class="mb-4 text-2xl text-cyan-600">Modifier la scène</h2>

          <input
            type="text"
            name="nom"
            value={scene.nom_scene}
            class="my-4 rounded-md border p-2"
          />

          <input
            type="text"
            name="localisation"
            value={scene.localisation}
            class="my-4 rounded-md border p-2"
          />

          <textarea name="description" class="my-4 rounded-md border p-2">
            {scene.description_scene}
          </textarea>

          <label>Changer la photo :</label>
          <input
            type="file"
            name="photo_scene"
            class="my-4 rounded-md border p-2"
          />

          <input
            type="submit"
            value="Modifier"
            class="rounded-lg bg-slate-500 p-5"
          />
        </form>

        <form method="POST" class="mt-4">
          <button
            name="delete"
            value="1"
            class="rounded bg-red-600 p-3 text-white"
          >
            Supprimer la scène
          </button>
        </form>
      </>
    )
  }
</Layout>
